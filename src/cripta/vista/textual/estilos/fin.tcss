/* Pantallas finales: derrota en rojo sobre negro, victoria en dorado. */
FinModal {
    background: #070707;
    align: center middle;
}

FinModal #fin-root {
    width: 100%;
    height: 100%;
    padding: 1 2;
    background: #070707;
}

FinModal #fin-epilogo {
    height: 1;
    color: #928880;
    content-align: center middle;
}

FinModal #fin-titulo {
    height: 3;
    margin: 1 0;
    background: #100c0c;
    color: #c3aa80;
    text-style: bold;
    content-align: center middle;
}

FinModal.derrota #fin-titulo {
    color: #cf554c;
    background: #140a0a;
}

FinModal.victoria #fin-titulo {
    color: #e8c878;
    background: #141109;
}

FinModal #fin-detalle {
    height: 1fr;
    min-height: 1;
}

FinModal #fin-resumen {
    height: auto;
    color: #928880;
    content-align: center middle;
    margin-bottom: 1;
}

FinModal #fin-error {
    height: auto;
    color: #e88275;
    content-align: center middle;
}

FinModal #fin-tabla {
    height: 1fr;
    min-height: 3;
    max-height: 12;
    background: #0d0c0b;
    color: #b4aaa0;
    border: none;
}

FinModal #fin-acciones {
    height: 3;
    margin-top: 1;
    align: center middle;
}

FinModal #fin-acciones Button {
    min-width: 20;
    margin: 0 1;
    background: #171311;
    color: #c9b8a0;
    border: tall #44352d;
}

FinModal #fin-acciones Button:hover,
FinModal #fin-acciones Button:focus {
    background: #2a1815;
    color: #f0d8c4;
    border: tall #b33a32;
}

FinModal.victoria #fin-acciones Button:focus {
    border: tall #e8c878;
}

FinModal #fin-causa {
    height: auto;
    color: #e88275;
    text-style: bold;
    content-align: center middle;
    margin-bottom: 1;
}

FinModal #fin-acontecimientos {
    height: auto;
    color: #b4aaa0;
    content-align: center middle;
    margin-bottom: 1;
}
