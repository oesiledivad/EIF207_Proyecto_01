/*
   juego.tcss — Pantalla de juego (layout base)
    */

JuegoScreen {
    background: #0d0b0a;
}

#juego-root {
    height: 100%;
    padding: 0 1;
}

#barra-superior {
    height: auto;
    background: #15110f;
    color: #e8a33d;
    text-style: bold;
    padding: 0 1;
    margin-bottom: 1;
}

#juego-columnas {
    layout: horizontal;
    height: 1fr;
}

.panel-col {
    height: 100%;
    background: #15110f;
    border: round #2a221d;
    padding: 1;
    margin: 0 1;
}

.section-title {
    color: #e8a33d;
    text-style: bold;
    margin-bottom: 1;
}

#col-izq { width: 25%; }
#col-centro { width: 45%; }
#col-der { width: 30%; }

#mini-mapa {
    height: 15;
    margin-bottom: 1;
}

#acciones-juego {
    height: 3;
    margin-top: 1;
}

#acciones-juego Button {
    margin: 0 1;
}

#barra-acciones {
    grid-size: 7;
    grid-columns: 1fr;
    grid-rows: 3;
    height: 6;
    max-height: 40%;
    overflow-y: auto;
    margin-top: 1;
}

#barra-acciones Button {
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
}

JuegoScreen.-estrecha #juego-columnas {
    layout: vertical;
}

JuegoScreen.-estrecha .panel-col {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

JuegoScreen.-estrecha #col-izq,
JuegoScreen.-estrecha #col-centro,
JuegoScreen.-estrecha #col-der {
    width: 100%;
}

JuegoScreen.-estrecha #barra-acciones {
    grid-size: 3;
    height: 15;
}

JuegoScreen.-muy-estrecha #barra-acciones {
    grid-size: 2;
    height: 21;
}

JuegoScreen.-baja .panel-col {
    padding: 0;
}

JuegoScreen.-baja #barra-superior {
    max-height: 2;
    margin-bottom: 0;
}

JuegoScreen.-baja #barra-acciones {
    margin-top: 0;
}

.panel-col Static {
    height: auto;
}
