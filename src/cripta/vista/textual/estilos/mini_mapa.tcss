MiniMapa {
    layout: grid;
    grid-size: 3 3;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: 1fr 1fr 1fr;
    width: 100%;
    height: 15;
    min-height: 15;
    background: #15110f;
    border: solid #2a221e;
    margin: 0 0 1 0;
}

CeldaMapa {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    background: #100d0c;
    color: #555555;
    border: solid #2a221e;
}

CeldaMapa.-vacia {
    border: transparent;
    background: transparent;
}

CeldaMapa.-actual {
    border: double #e8a33d;
    background: #211913;
    color: #ffffff;
    text-style: bold;
}

CeldaMapa.-cerrada {
    border: solid #c9a227;
    color: #c9a227;
}

CeldaMapa.-salida {
    border: solid #8b7fb8;
    color: #8b7fb8;
}
CeldaMapa {
    min-width: 0;
    padding: 0;
}

CeldaMapa:disabled {
    opacity: 100%;
}

CeldaMapa:hover, CeldaMapa:focus {
    background: #2a221d;
    color: #e8a33d;
}
