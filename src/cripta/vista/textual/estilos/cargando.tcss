/*
   cargando.tcss — Spinner de carga, dos modos
   */

/* Modo pantalla: fondo opaco a pantalla completa */

CargandoScreen.-pantalla {
    background: #0d0b0a;
    align: center middle;
}

CargandoScreen.-pantalla #cargando-caja {
    width: 95%;
    max-width: 50;
    height: 5;
    background: #15110f;
    border: round #e8a33d;
    padding: 1 2;
    align: center middle;
}

/* Modo modal: fondo semitransparente */

CargandoScreen.-modal {
    background: #0d0b0a 80%;
    align: center middle;
}

CargandoScreen.-modal #cargando-caja {
    width: 95%;
    max-width: 40;
    height: 5;
    background: #15110f;
    border: round #e8a33d;
    padding: 1 2;
    align: center middle;
}

/* Común */

#cargando-texto {
    content-align: center middle;
    color: #d6cfc4;
}