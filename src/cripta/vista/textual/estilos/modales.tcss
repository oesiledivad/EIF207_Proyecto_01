/*
   modales.tcss — Estilos de modales
   */

ModalScreen {
    align: center middle;
    background: #0d0b0a 80%;
}

#modal-root {
    width: 70;
    height: auto;
    max-height: 80%;
    background: #15110f;
    border: round #e8a33d;
    padding: 1 2;
}

#modal-titulo {
    color: #e8a33d;
    text-style: bold;
    content-align: center middle;
    height: 3;
}

#modal-cuerpo {
    color: #d6cfc4;
    padding: 1;
}

#modal-tabla {
    height: 15;
    border: round #2a221d;
}

#modal-tabla:focus {
    border: round #e8a33d;
}

#modal-acciones {
    height: 3;
    align: center middle;
    margin-top: 1;
}

#modal-acciones Button {
    margin: 0 1;
}