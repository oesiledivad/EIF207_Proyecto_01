/*
   base.tcss — Paleta "Cripta" y estilos globales

   Paleta (referencia, no variables reales de TCSS):
     Fondo principal     #0d0b0a
     Fondo panel         #15110f
     Fondo elevado       #1c1714
     Borde sutil         #2a221d
     Borde activo        #6b5647
     Texto principal     #d6cfc4
     Texto secundario    #8a7f72
     Texto deshabilitado #4a423b
     Antorcha (cálido)   #e8a33d
     Hiedra (frío)       #7fa88a
     Sangre              #a83a3a
     Hueso               #c9b8a0
     Runa                #8b7fb8
     Llave               #c9a227
     Sombra              #3a2f28
    */

Screen {
    background: #0d0b0a;
    color: #d6cfc4;
}

/* Etiquetas y texto */

Label {
    color: #d6cfc4;
}

.section-title {
    color: #e8a33d;
    text-style: bold;
}

.text-secondary {
    color: #8a7f72;
}

.text-disabled {
    color: #4a423b;
}

.text-danger {
    color: #a83a3a;
    text-style: bold;
}

.text-success {
    color: #7fa88a;
    text-style: bold;
}

/* Entradas de texto */

Input {
    background: #15110f;
    color: #d6cfc4;
    border: tall #2a221d;
}

Input:focus {
    border: tall #e8a33d;
}

Input > .input--placeholder {
    color: #4a423b;
}

/* Botones */

Button {
    background: #1c1714;
    color: #d6cfc4;
    border: none;
    text-style: bold;
    min-width: 16;
}

Button:hover {
    background: #2a221d;
}

Button:focus {
    background: #2a221d;
    color: #e8a33d;
}

Button.-primary {
    background: #6b5647;
    color: #f2e9dc;
}

Button.-primary:hover {
    background: #8a7059;
}

Button.-primary:focus {
    background: #8a7059;
    color: #e8a33d;
}

Button.-danger {
    background: #5a2424;
    color: #f2e9dc;
}

Button.-danger:hover {
    background: #7a2f2f;
}

Button.-danger:focus {
    background: #7a2f2f;
    color: #e8a33d;
}

/* Tablas */

DataTable {
    background: #15110f;
    color: #d6cfc4;
}

DataTable > .datatable--header {
    background: #1c1714;
    color: #e8a33d;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #6b5647;
    color: #f2e9dc;
}

DataTable > .datatable--hover {
    background: #1c1714;
}

/* Pie de página  */

Footer {
    background: #15110f;
    color: #8a7f72;
}

Footer > .footer--key {
    background: #2a221d;
    color: #e8a33d;
}

Footer > .footer--description {
    color: #8a7f72;
}